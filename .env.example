# Copy this file to `.env` and fill in real values before `docker compose up -d`.
# Never commit the real `.env` to git (it is already in .gitignore).

# ---------- PostgreSQL ----------
POSTGRES_USER=vmware_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vmware_capacity_ops

# ---------- App / Auth ----------
# Random long string — e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# Bootstrap password for the first login (only used the very first time the
# `users` table is empty). Change it after first login, or rotate with:
#   docker compose exec app python -m app.seed --username admin --password 'NewPass!'
ADMIN_PASSWORD=change-me-strong-password
# Set to true once the app is served over HTTPS (behind a reverse proxy / TLS terminator)
COOKIE_SECURE=false

# Restrict in production to your actual frontend origin(s), comma-separated.
# "*" is fine when frontend and backend are served from the same origin
# (the default setup here — FastAPI serves the static frontend itself).
CORS_ORIGINS=*

# ---------- Background vCenter polling ----------
ENABLE_SCHEDULER=true
POLL_INTERVAL_MINUTES=60
APP_PORT=8000

# ---------- vCenter #1..#4 ----------
# Use the SAME read-only account (e.g. infra.mon@vsphere.local) on every
# vCenter — see README.md "Tạo tài khoản read-only trên vCenter" for the
# exact custom-role permissions to grant.
# Set VCENTER_i_DEMO=true (and leave HOST/PASSWORD blank) to run against the
# built-in synthetic data generator instead of a real vCenter — useful for a
# first smoke test before you have real vCenter access wired up.

VCENTER_1_KEY=vc-hcm-01
VCENTER_1_NAME=vCenter HCM DC1
VCENTER_1_HOST=vcenter01.yourcompany.local
VCENTER_1_USERNAME=infra.mon@vsphere.local
VCENTER_1_PASSWORD=change-me
VCENTER_1_VERIFY_SSL=false
VCENTER_1_DEMO=false

VCENTER_2_KEY=vc-hcm-02
VCENTER_2_NAME=vCenter HCM DC2
VCENTER_2_HOST=vcenter02.yourcompany.local
VCENTER_2_USERNAME=infra.mon@vsphere.local
VCENTER_2_PASSWORD=change-me
VCENTER_2_VERIFY_SSL=false
VCENTER_2_DEMO=false

VCENTER_3_KEY=vc-dr-01
VCENTER_3_NAME=vCenter DR Site
VCENTER_3_HOST=vcenter03.yourcompany.local
VCENTER_3_USERNAME=infra.mon@vsphere.local
VCENTER_3_PASSWORD=change-me
VCENTER_3_VERIFY_SSL=false
VCENTER_3_DEMO=false

VCENTER_4_KEY=vc-branch-01
VCENTER_4_NAME=vCenter Branch
VCENTER_4_HOST=vcenter04.yourcompany.local
VCENTER_4_USERNAME=infra.mon@vsphere.local
VCENTER_4_PASSWORD=change-me
VCENTER_4_VERIFY_SSL=false
VCENTER_4_DEMO=false
